# Server configuration only. Never prefix credentials with NEXT_PUBLIC_.
# Installation guide: docs/vercel-wix-setup.md
APP_ORIGIN=
WIX_SITE_ORIGIN=https://www.ibgenie.com
WIX_ALLOWED_ORIGINS=https://www.ibgenie.com,https://ibgenie.com
WIX_UPGRADE_URL=https://www.ibgenie.com/plans-pricing
# Actual Wix Pricing Plans IDs, separated by commas. Names and roles are not IDs.
WIX_PRO_PLAN_IDS=
# Two different random secrets, at least 32 characters each.
WIX_BRIDGE_SECRET=
SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Both OpenAI and QStash are needed for live voice.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
QSTASH_TOKEN=
FREE_DAILY_MESSAGE_LIMIT=10
PRO_DAILY_AI_LIMIT=200
PRO_DAILY_VOICE_LIMIT=10
VOICE_SESSION_MINUTES=10
AI_WORKSPACE_DAILY_LIMIT=2000
VOICE_WORKSPACE_DAILY_LIMIT=100
